# Files that run on the Linux server must keep LF line endings even when checked out on Windows
# (core.autocrlf=true would otherwise turn them into CRLF and break them: "bash\r: bad interpreter").
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
Caddyfile       text eol=lf
deploy/*        text eol=lf
