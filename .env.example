# Summer AI Content Automation — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Application environment: development or production
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database URL (SQLite for dev, Postgres for prod)
# SQLite example: sqlite:///./data/app.db
# Postgres example: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# Anthropic API key for Claude
# Get this from https://console.anthropic.com → API Keys
# IMPORTANT: A Claude.ai subscription does NOT include API credits.
# You must create an API key AND add credits at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: Mistral as an alternative / fallback provider (https://console.mistral.ai)
MISTRAL_API_KEY=
# ministral-8b-latest works on the free tier (verified live). mistral-small/large/medium-latest need a paid tier for quota.
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_MAX_TOKENS=2048

# auto = Anthropic if its key is set (Mistral used as fallback if it fails), else Mistral
# anthropic | mistral = force one provider, no fallback
LLM_PROVIDER=auto

# Claude model to use (default: opus-5-5; cheaper alternative: sonnet-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Claude thinking effort: low, medium, high
CLAUDE_EFFORT=medium

# Max tokens for Claude response (thinking counts toward this; don't lower)
CLAUDE_MAX_TOKENS=16000

# Request timeout in seconds
CLAUDE_TIMEOUT_SECONDS=120

# SDK retries for transient errors (429/5xx/connection)
CLAUDE_MAX_RETRIES=2

# Show the AI the actual image / video frames (uploaded or synced files only; Dropbox links can't be fetched)
# Needs ffmpeg for videos (on PATH, or set FFMPEG_PATH). Images are sent to the AI provider you configured.
ENABLE_IMAGE_INPUT=true
FFMPEG_PATH=
MAX_FRAMES=3

# Media upload directory (created on startup)
MEDIA_UPLOAD_DIR=./data/media

# Optional: Dropbox desktop sync folder (read-only, e.g. C:\Users\<you>\Dropbox\Summer)
# If set, enables "Sync Dropbox folder" feature
MEDIA_SYNC_DIR=

# Max upload size for images (MB)
MAX_IMAGE_MB=25

# Max upload size for videos (MB)
MAX_VIDEO_MB=500

# Timezone for display (must be valid IANA zone, e.g. Europe/London, America/New_York)
# All timestamps stored in UTC; this is only for display
APP_TIMEZONE=UTC

# Optional: Enable HTTP Basic Auth on dashboard (except /health)
# Both must be set to enable
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Rate limit for generation endpoints (requests per minute per IP)
GENERATION_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
# ==== Phase 2: publishing (PLAN_PHASE2.md §5) ====
# Publishing mode: off / reminders / dry_run / live (the ONLY publishing switch)
PUBLISHING_MODE=off
# Public https base URL (required for live + OAuth; also used in push links)
PUBLIC_BASE_URL=
# Platform tokens at rest: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# HMAC key for public signed media URLs (/m/{token}); python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_URL_SECRET=

# Platform apps (Instagram API with Unified Login / TikTok Content Posting API)
# Instagram: Meta APP id + secret, and the Facebook Login for Business configuration id (not secret)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# inbox (default; video -> TikTok drafts) or direct (mock-only until audited)
TIKTOK_POST_MODE=inbox

# Worker
WORKER_INTERVAL_SECONDS=60
PUBLISH_MAX_ATTEMPTS=3
PLATFORM_TIMEOUT_SECONDS=60

# Weekly planner
AUTO_PLAN_ENABLED=false
PLANNER_RUN_HOUR=6
PLANNER_LEAD_MINUTES=30
PLANNER_MAX_TOPUP_PER_DAY=3

# Push notifications: none / telegram / ntfy / pushover
NOTIFY_PROVIDER=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Dropbox sync disk guard (GB of free space below which sync-media refuses)
MIN_FREE_DISK_GB=2

# ---- Phase 3: Fanvue (PLAN_PHASE3 §4) ----
# From Lee's "API only" app at https://www.fanvue.com/dev (secret is shown once)
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_API_VERSION=2025-06-26
# Space-separated. Never add write:creator (prices/promotions/payouts stay in Fanvue).
FANVUE_SCOPES=read:self read:creator read:post write:post read:media write:media read:chat write:chat read:fan read:insights read:tracking_links write:tracking_links
FANVUE_INBOX_POLL_SECONDS=120
# Pay-to-view price limits in cents (Lee types the price; it must be inside this range)
FANVUE_PPV_MIN_CENTS=300
FANVUE_PPV_MAX_CENTS=5000
# Fan message text is deleted after this many days
FAN_DATA_RETENTION_DAYS=90
# Weekly Fanvue report: 0 = Monday, hour in APP_TIMEZONE
FANVUE_REPORT_WEEKDAY=0
FANVUE_REPORT_HOUR=9
