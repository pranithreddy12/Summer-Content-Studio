# /etc/caddy/Caddyfile  -  Caddy fetches and renews the HTTPS certificate automatically.
# Cloudflare DNS for `studio` must be "DNS only" (grey cloud) so Caddy can get the certificate
# and Instagram/TikTok can fetch media directly.

studio.itsmesummer.app {
	encode zstd gzip
	request_body {
		max_size 600MB   # uploads of videos up to 500 MB (MAX_VIDEO_MB)
	}
	reverse_proxy 127.0.0.1:8000
}

# Apex domain: STATIC public pages only - no login, no app behind it. The Meta and TikTok developer apps ask for a
# Privacy Policy URL and a Terms of Service URL (https://itsmesummer.app/privacy and /terms); /privacy#data-deletion is the
# data-deletion instructions page. The files live in deploy/site/ and are copied to /var/www/summer-site, which the
# caddy user can read (see docs/DEPLOY.md, "Public pages"). Placeholders in them must be filled in first.
itsmesummer.app {
	root * /var/www/summer-site
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
	}
	try_files {path}.html {path}
	file_server
}
